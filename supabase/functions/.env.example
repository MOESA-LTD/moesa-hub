# Amazon SP-API (Solution Provider Portal → your app client → "View" and "Authorize").
# Copy to supabase/functions/.env (git-ignored) for local Edge Functions. Do NOT push this file
# to the hosted project as-is: set the hosted secrets one by one with `supabase secrets set NAME=…`
# (production values, see supabase/README.md "Amazon (M22)").
AMAZON_SPAPI_LWA_CLIENT_ID=
AMAZON_SPAPI_LWA_CLIENT_SECRET=
AMAZON_SPAPI_REFRESH_TOKEN=
# Seller id used with the self-authorized token (sandbox only; production comes from OAuth).
AMAZON_SPAPI_SELLER_ID=
# Required, no default: `sandbox` (local dev, the static sandbox) or `production` (hosted). Left
# empty, every Amazon function answers amazon_unconfigured (fails closed).
AMAZON_SPAPI_ENV=
# eu | na | fe  (sandbox host: sandbox.sellingpartnerapi-<region>.amazon.com)
AMAZON_SPAPI_REGION=eu
# The SP-API application id (amzn1.sp.solution.…), used to build the consent URL.
AMAZON_SPAPI_APP_ID=
# true while the app is still a draft (adds version=beta to the consent URL).
AMAZON_SPAPI_APP_BETA=true
# Signs the OAuth state: at least 32 random bytes, base64 (e.g. `openssl rand -base64 32`).
AMAZON_SPAPI_STATE_SECRET=
# The panel's base URL (the OAuth callback redirects back here) and the project's public URL (the
# callback's redirect_uri and the public image links Amazon fetches). Required in production; in
# sandbox they default to http://localhost:6161 and http://127.0.0.1:54321.
APP_URL=
PUBLIC_SUPABASE_URL=
# The panel's base URL (config site_url): provider invitations link to SITE_URL/invitation/<token>.
# Required: without it no invitation is created. Local: http://localhost:6161.
# Hosted: keep Auth sign-up disabled (enable_signup = false), add SITE_URL/invitation/** to the
# Auth redirect URLs (else the mailed link has no token), and note that the token appears in
# GoTrue's request logs through redirect_to (see supabase/config.toml [auth]).
# Open self-signup (create-account) links to SITE_URL/register/complete: add it to the Auth
# redirect URLs as well.
SITE_URL=
# Open self-signup (create-account) throttles per client address, read from x-forwarded-for
# counted from the right: the entry SIGNUP_TRUSTED_PROXY_HOPS from the end is the one the nearest
# trusted proxy appended (default 1: the rightmost). Entries further left are client-supplied and
# never used. Verify on the hosted project before opening sign-up:
#   1. deploy a temporary function that logs the x-forwarded-for entry count and each entry, plus
#      x-real-ip and cf-connecting-ip if present;
#   2. call it from two different networks, with and without a forged `X-Forwarded-For: 1.2.3.4`;
#   3. the right entry changes with the real network and never shows the forged value; count its
#      position from the right and set SIGNUP_TRUSTED_PROXY_HOPS to it (1 = last entry).
# Set too low, every caller shares one client-address bucket (30/h caps sign-up for everyone); set too
# high, a client can forge its address. The per-address (5/h) and global (200/h) limits stay.
SIGNUP_TRUSTED_PROXY_HOPS=1
